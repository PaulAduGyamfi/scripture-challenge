{
    "permissions": {
      "deny": [
        "Read(./.env)",
        "Read(./.env.*)",
        "Read(./state.json)",
        "Read(./backups/**)",
        "Read(./.wwebjs_auth/**)",
        "Bash(npm run deploy *)",
        "Bash(ssh *)",
        "Bash(scp *)",
        "Bash(git push --force *)"
      ],
      "ask": [
        "Bash(git push *)",
        "Bash(npm install *)",
        "Bash(npm uninstall *)"
      ]
    },
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Edit|Write",
          "hooks": [
            { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.mjs" }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck-on-stop.mjs", "timeout": 120 }
          ]
        }
      ]
    }
  }