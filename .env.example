# Claude API key, for reading messy guesses, hints and cheers
ANTHROPIC_API_KEY=paste-your-key-here

# Google Sheet of verses: File > Share > Publish to web > CSV, then paste the link
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/.../pub?output=csv

# Optional: the Stories tab for the 7 PM Emoji Bible game, published the same way.
# Leave empty to turn the game off.
STORIES_CSV_URL=

# Optional: the Riddles tab for the 10 AM Bible Riddle, published the same way.
# Leave empty to turn the game off.
RIDDLES_CSV_URL=

# The WhatsApp group to run in. Leave empty on the first run; the bot prints group IDs.
GROUP_ID=

# Your own WhatsApp ID, for the !new !hint !reveal test commands.
# Leave empty and the bot prints the sender of each message so you can find yours.
ADMIN_ID=

# Time zone for posting times and weekly/season resets
TZ_NAME=America/New_York

# Optional: AI judging of free-text Bible Riddle and Emoji Bible answers: on (the default) or off.
# off means only the answers listed in the sheet win; nothing is sent to the AI.
# The bot reads .env only when it starts, so restart it after changing this: pm2 restart scripture-bot
# AI_JUDGING=on
