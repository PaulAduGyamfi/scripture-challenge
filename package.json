{
  "name": "scripture-challenge",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "build": "tsc",
    "sim": "tsx src/sim.ts",
    "dev": "tsx src/bot.ts",
    "start": "node dist/bot.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src test .claude/hooks",
    "lint:ci": "oxlint --max-warnings 5 src test .claude/hooks",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \".claude/hooks/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \".claude/hooks/*.mjs\"",
    "prepare": "husky",
    "deploy": "./scripts/deploy.sh"
  },
  "keywords": [],
  "author": "Paul Adu-Gyamfi",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode-terminal": "^0.12.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "dotenv": "^18.0.5",
    "node-cron": "^4.6.0",
    "papaparse": "^5.7.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "puppeteer@24.38.0": true,
    "esbuild@0.28.2": true
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "oxlint"
    ]
  }
}
